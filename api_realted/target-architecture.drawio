<mxfile host="app.diagrams.net" type="device"><diagram id="target-arch" name="Target architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1248" pageHeight="1168" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="&lt;b&gt;Only the ingestion Lambda talks to Exchange; agents read the AWS copy&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="38" y="13" width="1139" height="42" as="geometry"/></mxCell><mxCell id="n12" value="Same layout in dev, UAT and prod: each has its own AWS account, mailbox, service account and secret" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="38" y="54" width="1139" height="29" as="geometry"/></mxCell><mxCell id="n13" value="Client on-prem network" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;container=0;" vertex="1" parent="1"><mxGeometry x="38" y="102" width="1139" height="205" as="geometry"/></mxCell><mxCell id="n14" value="AWS account, one per environment (dev / UAT / prod)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;container=0;" vertex="1" parent="1"><mxGeometry x="38" y="416" width="1139" height="666" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Amazon Bedrock AgentCore&lt;/b&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontSize=13;strokeColor=#7B4FD0;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#4B2E83;" ve