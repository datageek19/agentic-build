rcePoint"/><mxPoint x="310" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-phase-45" value="B · Kerberos: get a ticket for the SQL Server SPN (password → TGT → service ticket); no NTLM fallback from Linux" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9EDF2;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="20" y="416" width="2960" height="28" as="geometry"/></mxCell><mxCell id="seq-m-46" value="④ DNS: fpsql.boeing.com (A) · KDCs from krb5.conf or _kerberos._tcp.BOEING.COM (SRV) via Resolver rule" style="html=1;rounded=0;strokeColor=#D86613;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#D86613;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="468" as="sourcePoint"/><mxPoint x="910" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-47" value="SQL listener IP · KDC IPs" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="910" y="498" as="sourcePoint"/><mxPoint x="310" y="498" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-48" value="⑤ AS-REQ svc-fp-ro-prd@BOEING.COM (pre-auth, AES256) over TCP 88 — kinit / gssapi acquire_cred_with_password" style="html=1;rounded=0;strokeColor=#7B4FD0;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#7B4FD0;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-