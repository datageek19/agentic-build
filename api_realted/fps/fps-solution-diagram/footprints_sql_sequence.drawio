eColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1110" y="696" as="sourcePoint"/><mxPoint x="310" y="696" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-53" value="metric KerberosFailure=1 → alarm · STOP: no retries this run (protects the AD lockout counter); watermark unchanged" style="html=1;rounded=0;strokeColor=#D13212;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#D13212;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="726" as="sourcePoint"/><mxPoint x="2710" y="726" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-phase-54" value="C · Connect and log in to SQL Server (ODBC Driver 18, Trusted_Connection=yes, Encrypt=yes, TrustServerCertificate=no, ApplicationIntent=ReadOnly)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9EDF2;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="20" y="796" width="2960" height="28" as="geometry"/></mxCell><mxCell id="seq-m-55" value="⑦ TCP 1433 · TDS PRELOGIN (encryption required) → TLS handshake · verify chain against Boeing CA bundle + host name" style="html=1;rounded=0;strokeColor=#1F6FD1;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#1F6FD1;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="848" as="sourcePoint"/><mxPoint x="1310" y="848" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-56" value="LOGIN7 with SSPI token = Kerberos AP-REQ (inside the TLS session) · Database=FootPrints · read-only intent" style="html=1;rounded=0;strokeColor=#1F6FD1;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#1F6FD1;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="878" as="sourcePoint"/><mxPoint x="1310" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-self-57" value="validates the ticket with its own key (no DC round-trip) · maps to login BOEING\svc-fp-ro-prd · read-only routing if an AG listener" style="html=1;rounded=0;strokeColor=#7D8998;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=6;labelPosition=right;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="908" as="sourcePoint"/><mxPoint x="1310" y="930" as="targetPoint"/><Array as="points"><mxPoint x="1346" y="908"/><mxPoint x="1346" y="930"/></Array><mxPoint x="40" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="seq-m-58" value="LOGINACK · session established (encrypted TDS)" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="960" as="sourcePoint"/><mxPoint x="310" y="960" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-59" value="F2 · error 18456 (login not created / no database access) or 4060 (database unavailable)" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="1038" as="sourcePoint"/><mxPoint x="310" y="1038" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-60" value="metric SqlLoginFailure=1 → alarm · STOP · ask DBA to check login / user / grants" style="html=1;rounded=0;strokeColor=#D13212;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#D13212;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1068" as="sourcePoint"/><mxPoint x="2710" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-phase-61" value="D · Incremental read of workspace 144 with a rowversion watermark (MASTER144.mrTIMESTAMP is a SQL Server timestamp = rowversion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9EDF2;strokeColor=none;fontSize=13;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="20" y="1138" width="2960" height="28" as="geometry"/></mxCell><mxCell id="seq-note-62" value="⑧ SELECT @upper = MIN_ACTIVE_ROWVERSION();   -- every row below @upper is committed&lt;br&gt;SELECT TOP (200) mrID, mrTIMESTAMP, mrTITLE, mrSTATUS, mrSUBMITDATE, mrUPDATEDATE, mrSUBMITTER, mrASSIGNEES, mrATTACHMENTS, mrDESCRIPTION, &amp;lt;PO / invoice / supplier custom fields, e.g. PO__bNumber&amp;gt;&lt;br&gt;FROM dbo.MASTER144 WHERE mrTIMESTAMP &amp;gt; @watermark AND mrTIMESTAMP &amp;lt; @upper AND mrSTATUS &amp;lt;&amp;gt; '_SOLVED_' ORDER BY mrTIMESTAMP;   -- parameterised; _DELETED_ rows become tombstones (no agent run); mrTIMESTAMP has no index → run on the replica or ask DBA" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E6;strokeColor=#E3A008;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="1190" width="1500" height="88" as="geometry"/></mxCell><mxCell id="seq-m-63" value="≤ 200 changed tickets in ascending rowversion order" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="1306" as="sourcePoint"/><mxPoint x="310" y="1306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-64" value="SELECT mrID, mrGENERATION, mrDESCRIPTION FROM dbo.MASTER144_DESCRIPTIONS WHERE mrID IN (…) · same for MASTER144_HISTORY" style="html=1;rounded=0;strokeColor=#1F6FD1;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#1F6FD1;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1336" as="sourcePoint"/><mxPoint x="1310" y="1336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-65" value="description generations + history lines for the page" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="1366" as="sourcePoint"/><mxPoint x="310" y="1366" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-66" value="⑨ PutObject tickets/144/{mrID}/{rowversion}/ticket.json · descriptions.json · history.json (SSE-KMS, sha256)" style="html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1444" as="sourcePoint"/><mxPoint x="2110" y="1444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-67" value="⑨ PutItem fp_ledger {pk = 144#mrID#rowversion, status = SNAPSHOT} IF attribute_not_exists(pk)" style="html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1474" as="sourcePoint"/><mxPoint x="710" y="1474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-68" value="⑨ SendMessageBatch {mrID, rowversion, s3Prefix, attachmentNames} (latest version per mrID only)" style="html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1504" as="sourcePoint"/><mxPoint x="1510" y="1504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-69" value="⑩ UpdateItem fp_checkpoint SET watermark = last rowversion of the page — only after ⑨ succeeded for every row" style="html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1534" as="sourcePoint"/><mxPoint x="710" y="1534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-70" value="F3 · query timeout · 1205 deadlock victim · blocking beyond the timeout" style="html=1;rounded=0;strokeColor=#425466;strokeWidth=1.2;dashed=1;endArrow=open;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#425466;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="1310" y="1638" as="sourcePoint"/><mxPoint x="310" y="1638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-self-71" value="back off; end the run; watermark stays at the last committed page → next run re-reads the same window" style="html=1;rounded=0;strokeColor=#D13212;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#D13212;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=6;labelPosition=right;" edge="1" parent="1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="310" y="1668" as="sourcePoint"/><mxPoint x="310" y="1690" as="targetPoint"/><Array as="points"><mxPoint x="346" y="1668"/><mxPoint x="346" y="1690"/></Array><mxPoint x="40" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="seq-m-72" value="column renamed / removed in MASTER144* → alarm SchemaDrift · STOP until mapping updated" style="html=1;rounded=0;strokeColor=#D13212;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#D13212;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=1;spacingLeft=4;" edge="1" parent="1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="310" y="1758" as="sourcePoint"/><mxPoint x="2710" y="1758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq-m-73" value="release lease · metrics TicketsChanged, QueryMs,