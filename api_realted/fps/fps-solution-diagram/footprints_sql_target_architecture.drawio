e=8;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-lambda-42" target="l2-aurora-43"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1759" y="760"/><mxPoint x="1968" y="760"/></Array></mxGeometry></mxCell><mxCell id="l2-grp-110" value="Legend" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1340" width="1015" height="112" as="geometry"/></mxCell><mxCell id="l2-txt-111" value="&lt;font color='#1F6FD1'&gt;&lt;b&gt;━━ blue&lt;/b&gt;&lt;/font&gt;: TDS (SQL) over TLS on 1433, SMB 445 (AWS → on-prem) &amp;nbsp; | &amp;nbsp; &lt;font color='#7B4FD0'&gt;&lt;b&gt;━━ purple&lt;/b&gt;&lt;/font&gt;: Kerberos AS/TGS to the KDC on 88&lt;br&gt;&lt;font color='#D86613'&gt;&lt;b&gt;┅┅ orange&lt;/b&gt;&lt;/font&gt;: DNS (UDP/TCP 53) hybrid resolution &amp;nbsp; | &amp;nbsp; &lt;font color='#232F3E'&gt;&lt;b&gt;━━ dark&lt;/b&gt;&lt;/font&gt;: AWS API calls inside the account (IAM-signed, via VPC endpoints)&lt;br&gt;&lt;font color='#01A88D'&gt;&lt;b&gt;━━ teal&lt;/b&gt;&lt;/font&gt;: agentic workflow / AgentCore invocations &amp;nbsp; | &amp;nbsp; &lt;font color='#D13212'&gt;&lt;b&gt;┅┅ red&lt;/b&gt;&lt;/font&gt;: failure, retry, alarm paths&lt;br&gt;&lt;font color='#7D8998'&gt;&lt;b&gt;┅┅ grey&lt;/b&gt;&lt;/font&gt;: existing on-prem flows / permissions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2933;spacing=2;" vertex="1" parent="l2-grp-110"><mxGeometry x="10" y="22" width="990" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="env" name="3 - Dev / UAT / Prod environments"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="env-txt-1" value="&lt;b&gt;Environment topology — FootPrints read-only SQL access for Dev, UAT and Prod&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#1F2933;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2300" height="34" as="geometry"/></mxCell><mxCell id="env-txt-2" value="Given: two read-only Windows domain service accounts (non-prod, prod). Everything marked &lt;b&gt;[to provision]&lt;/b&gt; or &lt;b&gt;[Validate]&lt;/b&gt; must be requested from the Boeing DBA, AD, FootPrints and network teams." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2300" height="30" as="geometry"/></mxCell><mxCell id="env-grp-3" value="Boeing on-premises" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="700" height="1120" as="geometry"/></mxCell><mxCell id="env-grp-4" value="Production FootPrints [Confirmed]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="50" width="660" height="250" as="geometry"/></mxCell><mxCell id="env-box-5" value="&lt;b&gt;Prod SQL listener&lt;/b&gt; fpsql.boeing.com:1433 [placeholder]&lt;br&gt;FootPrints DB · workspace 144&lt;br&gt;readable secondary / reporting replica [Validate]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="50" width="380" height="80" as="geometry"/></mxCell><mxCell id="env-box-6" value="&lt;b&gt;svc-fp-ro-prd&lt;/b&gt; [Confirmed]&lt;br&gt;SELECT on MASTER144* only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="420" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="env-box-7" value="Attachment share (prod) — read-only [Decision]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="150" width="620" height="40" as="geometry"/></mxCell><mxCell id="env-grp-8" value="Non-production FootPrints [Validate: exists, refresh policy]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="320" width="660" height="250" as="geometry"/></mxCell><mxCell id="env-box-9" value="&lt;b&gt;Non-prod SQL listener&lt;/b&gt; fpsql-np.boeing.com:1433 [placeholder]&lt;br&gt;FootPrints DB copy · workspace 144" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-8"><mxGeometry x="20" y="50" width="380" height="80" as="geometry"/></mxCell><mxCell id="env-box-10" value="&lt;b&gt;svc-fp-ro-nonprod&lt;/b&gt; [Confirmed]&lt;br&gt;SELECT on MASTER144* only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-8"><mxGeometry x="420" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="env-box-11" value="Attachment share (non-prod) — read-only [Decision]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="env-grp-8"><mxGeometry x="20" y="150" width="620" height="40" as="geometry"/></mxCell><mxCell id="env-box-12" value="&lt;b&gt;AD KDCs + DNS&lt;/b&gt; (shared by both environments)&lt;br&gt;SPNs: MSSQLSvc/&amp;lt;host&amp;gt;:1433 for prod and non-prod [Validate]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="590" width="660" height="60" as="geometry"/></mxCell><mxCell id="env-box-13" value="&lt;b&gt;Boeing firewall&lt;/b&gt; — three rule sets [to provision]&lt;br&gt;VPC-dev → non-prod 1433/88 (smoke test only, optional) · VPC-uat → non-prod 1433/88/445 · VPC-prd → prod 1433/88/445 · Resolver ENIs → DNS 53 · deny all else" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="670" width="660" height="90" as="geometry"/></mxCell><mxCell id="env-box-14" value="&lt;b&gt;If no non-prod FootPrints exists&lt;/b&gt; [Assumption to validate]: UAT reads a DBA-provided, sanitized copy of the FootPrints DB restored on a non-prod SQL Server; it never reads production with the non-prod account. Production data in UAT needs export-control and privacy approval." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="780" width="660" height="100" as="geometry"/></mxCell><mxCell id="env-grp-15" value="Network hub account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="360" height="1120" as="geometry"/></mxCell><mxCell id="env-direct_connect-16" value="&lt;b&gt;Direct Connect / S2S VPN&lt;/b&gt;&lt;br&gt;[Validate: existing]" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="env-grp-15"><mxGeometry x="151" y="70" width="52" height="52" as="geometry"/></mxCell><mxCell id="env-transit_gateway-17" value="&lt;b&gt;Transit Gateway&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,