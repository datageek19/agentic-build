rticalAlign=middle;" edge="1" parent="1" source="l1-box-19" target="l1-box-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-e-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C86;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#5A6C86;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="l1-box-20" target="l1-box-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-e-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C86;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#5A6C86;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="l1-box-19" target="l1-box-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-e-37" value="reads only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C86;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#5A6C86;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-box-18" target="l1-box-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="149" y="760"/><mxPoint x="155" y="760"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l2" name="2 - Level 2 detailed architecture (per environment)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l2-txt-1" value="&lt;b&gt;BMC FootPrints (on-premises SQL Server) → AWS read-only ticket ingestion with Kerberos → Bedrock AgentCore workflow — Level 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#1F2933;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2600" height="34" as="geometry"/></mxCell><mxCell id="l2-txt-2" value="One environment shown (PROD). Dev and UAT are identical stacks in their own accounts (page 3). Tags: &lt;b&gt;[Confirmed]&lt;/b&gt; stated requirement · &lt;b&gt;[Recommended]&lt;/b&gt; design choice · &lt;b&gt;[Validate]&lt;/b&gt; confirm with Boeing DBA / AD / network / FootPrints owners · &lt;b&gt;[Decision]&lt;/b&gt; needs approval. Circled numbers ①–⑱ match the sequence diagram and the implementation guide." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2600" height="40" as="geometry"/></mxCell><mxCell id="l2-users-3" value="&lt;b&gt;FootPrints users / requesters&lt;/b&gt;&lt;br&gt;tickets created in workspace 144" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="44" height="44" as="geometry"/></mxCell><mxCell id="l2-grp-4" value="Boeing on-premises network — enterprise trust zone  [Confirmed: read-only SQL access to the FootPrints backend is permitted]" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="820" height="1110" as="geometry"/></mxCell><mxCell id="l2-box-5" value="&lt;b&gt;FootPrints web / app server&lt;/b&gt; (BMC FootPrints Service Core 11.6) — existing" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="50" width="530" height="56" as="geometry"/></mxCell><mxCell id="l2-documents-6" value="&lt;b&gt;Attachment store&lt;/b&gt;&lt;br&gt;files on the FootPrints&lt;br&gt;server; SQL keeps names&lt;br&gt;only (mrATTACHMENTS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.documents;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="l2-grp-4"><mxGeometry x="595" y="40" width="38" height="46" as="geometry"/></mxCell><mxCell id="l2-grp-7" value="Microsoft SQL Server — FootPrints DB  [Validate: version / HA]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="130" width="530" height="490" as="geometry"/></mxCell><mxCell id="l2-box-8" value="&lt;b&gt;SQL listener / instance&lt;/b&gt;&lt;br&gt;fpsql.boeing.com,1433 [placeholder]&lt;br&gt;static TCP port (no SQL Browser)&lt;br&gt;CA-issued TLS cert, FQDN on SAN [Validate]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-7"><mxGeometry x="20" y="60" width="240" height="100" as="geometry"/></mxCell><mxCell id="l2-box-9" value="&lt;b&gt;Database engine&lt;/b&gt;&lt;br&gt;Windows authentication (Kerberos)&lt;br&gt;SPN MSSQLSvc/fpsql.boeing.com:1433&lt;br&gt;login BOEING\svc-fp-ro-prd" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-7"><mxGeometry x="280" y="60" width="235" height="100" as="geometry"/></mxCell><mxCell id="l2-box-10" value="&lt;b&gt;Readable secondary&lt;/b&gt; [if an AG exists]&lt;br&gt;ApplicationIntent=ReadOnly →&lt;br&gt;read-only routing; keeps load&lt;br&gt;off the OLTP primary [Recommended]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-7"><mxGeometry x="20" y="215" width="240" height="110" as="geometry"/></mxCell><mxCell id="l2-generic_database-11" value="&lt;b&gt;FootPrints DB – workspace 144&lt;/b&gt;&lt;br&gt;MASTER144 · MASTER144_DESCRIPTIONS&lt;br&gt;MASTER144_HISTORY · MASTER144_ABDATA&lt;br&gt;MASTER144_TIMETRACKING" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_database;" vertex="1" parent="l2-grp-7"><mxGeometry x="375" y="215" width="44" height="52" as="geometry"/></mxCell><mxCell id="l2-box-12" value="&lt;b&gt;Read-only permission [Validate with DBA]&lt;/b&gt;&lt;br&gt;login from Windows · db user · GRANT SELECT on the five MASTER144* tables&lt;br&gt;(or on DBA-owned views in schema &lt;i&gt;airead&lt;/i&gt;) · VIEW DEFINITION for schema checks&lt;br&gt;no INSERT / UPDATE / DELETE / EXECUTE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E3A008;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-7"><mxGeometry x="20" y="370" width="495" height="100" as="geometry"/></mxCell><mxCell id="l2-grp-13" value="Active Directory (Kerberos realm BOEING.COM [placeholder])" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="l2-grp-4"><mxGeometry x="575" y="130" width="230" height="490" as="geometry"/></mxCell><mxCell id="l2-traditional_server-14" value="&lt;b&gt;AD DS domain controllers&lt;/b&gt;&lt;br&gt;KDC: AS / TGS TCP+UDP 88&lt;br&gt;AES256 tickets [Validate]" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="l2-grp-13"><mxGeometry x="95" y="60" width="40" height="48" as="geometry"/></mxCell><mxCell id="l2-role-15" value="&lt;b&gt;Read-only service accounts&lt;/b&gt;&lt;br&gt;svc-fp-ro-nonprod [Confirmed]&lt;br&gt;svc-fp-ro-prd [Confirmed]&lt;br&gt;non-interactive, AES enabled" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="l2-grp-13"><mxGeometry x="93" y="190" width="44" height="44" as="geometry"/></mxCell><mxCell id="l2-box-16" value="&lt;b&gt;Enterprise PKI&lt;/b&gt;&lt;br&gt;SQL Server TLS cert;&lt;br&gt;CA chain → Lambda trust store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-13"><mxGeometry x="15" y="330" width="200" height="66" as="geometry"/></mxCell><mxCell id="l2-box-17" value="&lt;b&gt;Internal DNS&lt;/b&gt;&lt;br&gt;A / SRV records (_kerberos)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-13"><mxGeometry x="15" y="415" width="200" height="56" as="geometry"/></mxCell><mxCell id="l2-generic_firewall-18" value="&lt;b&gt;Boeing firewall&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_firewall;" vertex="1" parent="l2-grp-4"><mxGeometry x="605" y="680" width="48" height="48" as="geometry"/></mxCell><mxCell id="l2-customer_gateway-19" value="&lt;b&gt;WAN edge / DX router&lt;/b&gt;&lt;br&gt;customer gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.customer_gateway;" vertex="1" parent="l2-grp-4"><mxGeometry x="725" y="680" width="48" height="48" as="geometry"/></mxCell><mxCell id="l2-box-20" value="&lt;b&gt;Firewall rules, one set per environment [Validate]&lt;/b&gt;&lt;br&gt;ALLOW env subnet CIDRs → SQL listener (+ replicas) TCP 1433&lt;br&gt;ALLOW env subnet CIDRs → DCs TCP+UDP 88&lt;br&gt;ALLOW env subnet CIDRs → file server TCP 445 (only if attachments via SMB)&lt;br&gt;ALLOW Resolver ENI IPs → DNS UDP/TCP 53 · DENY all else" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-4"><mxGeometry x="570" y="790" width="235" height="150" as="geometry"/></mxCell><mxCell id="l2-box-21" value="&lt;b&gt;Option B — fallback&lt;/b&gt;: on-prem export job (SQL Agent / SSIS) or relay writes ticket deltas to S3 over outbound HTTPS 443 (IAM Roles Anywhere). Use only if inbound AWS → SQL 1433 / KDC 88 is refused." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="660" width="530" height="80" as="geometry"/></mxCell><mxCell id="l2-box-22" value="&lt;b&gt;Option C — reporting replica [Recommended if no readable secondary]&lt;/b&gt;: DBA-maintained replica of the FootPrints DB on a separate server (log shipping, replication or AG secondary); query that copy (same Kerberos design, different host)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="755" width="530" height="80" as="geometry"/></mxCell><mxCell id="l2-box-23" value="&lt;b&gt;Trust boundary (on-prem ↔ AWS)&lt;/b&gt;&lt;br&gt;Only the two fp-* Lambdas open connections, outbound from AWS to SQL (1433), the KDCs (88) and, optionally, the attachment share (445); DNS goes from the Resolver endpoint. Nothing on-prem connects into AWS in Option A. The password leaves Secrets Manager only into Lambda memory to obtain a Kerberos ticket; it is never logged or given to agents." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="950" width="785" height="100" as="geometry"/></mxCell><mxCell id="l2-txt-24" value="&lt;b&gt;Existing ticket path (unchanged):&lt;/b&gt; requesters → FootPrints web UI / email-to-ticket → FootPrints app → SQL Server." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;spacing=2;" vertex="1" parent="l2-grp-4"><mxGeometry x="20" y="1065" width="780" height="30" as="geometry"/></mxCell><mxCell id="l2-grp-25" value="Hybrid connectivity [Validate: existing circuits]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#F7F4FF;strokeColor=#8C4FFF;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="860" y="660" width="175" height="560" as="geometry"/></mxCell><mxCell id="l2-direct_connect-26" value="&lt;b&gt;AWS Direct Connect&lt;/b&gt;&lt;br&gt;private / transit VIF&lt;br&gt;→ Direct Connect gateway" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="l2-grp-25"><mxGeometry x="61" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-site_to_site_vpn-27" value="&lt;b&gt;Site-to-Site VPN&lt;/b&gt;&lt;br&gt;2 IPsec tunnels, BGP&lt;br&gt;(backup)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="l2-grp-25"><mxGeometry x="61" y="220" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-txt-28" value="TDS is encrypted with TLS (Encrypt=yes). Kerberos protects the login, not the data stream, so TLS is mandatory. Add MACsec or VPN-over-DX if policy requires layer-3 encryption." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A30B5;spacing=2;" vertex="1" parent="l2-grp-25"><mxGeometry x="8" y="380" width="160" height="170" as="geometry"/></mxCell><mxCell id="l2-grp-29" value="AWS GovCloud (US-West)  [Decision: confirmed by export control for ITAR-bearing ticket data]" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1055" y="90" width="1730" height="1470" as="geometry"/></mxCell><mxCell id="l2-grp-30" value="Network hub account (shared networking)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="l2-grp-29"><mxGeometry x="20" y="50" width="305" height="1000" as="geometry"/></mxCell><mxCell id="l2-transit_gateway-31" value="&lt;b&gt;AWS Transit Gateway&lt;/b&gt;&lt;br&gt;route tables rt-dev | rt-uat | rt-prd&lt;br&gt;(segmented: no dev↔prd)&lt;br&gt;on-prem CIDRs from DX/VPN" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="l2-grp-30"><mxGeometry x="125" y="70" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-route_53-32" value="&lt;b&gt;Route 53 Resolver&lt;/b&gt;&lt;br&gt;outbound endpoint (2 AZs)&lt;br&gt;rule: boeing.com → on-prem DNS&lt;br&gt;shared to workload accounts (RAM)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="l2-grp-30"><mxGeometry x="125" y="290" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-txt-33" value="TGW attachments: DX gateway, VPN, VPC-dev, VPC-uat, VPC-prd. Each workload VPC sends only the FootPrints SQL, KDC and file-server CIDRs to the TGW. No internet egress." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#425466;spacing=2;" vertex="1" parent="l2-grp-30"><mxGeometry x="15" y="500" width="280" height="110" as="geometry"/></mxCell><mxCell id="l2-grp-34" value="Workload account — PROD   (Dev and UAT accounts are identical; see page 3)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="l2-grp-29"><mxGeometry x="340" y="50" width="1370" height="1400" as="geometry"/></mxCell><mxCell id="l2-grp-35" value="VPC vpc-fp-ingest-prd — private only: no IGW, no NAT [Recommended]" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="l2-grp-34"><mxGeometry x="20" y="50" width="760" height="810" as="geometry"/></mxCell><mxCell id="l2-grp-36" value="Private subnets AZ-a / AZ-b" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="l2-grp-35"><mxGeometry x="20" y="50" width="720" height="600" as="geometry"/></mxCell><mxCell id="l2-grp-37" value="FootPrints client tier — the only components with a network route and a credential to FootPrints" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#EEF5FD;strokeColor=#1F6FD1;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#1F6FD1;" vertex="1" parent="l2-grp-36"><mxGeometry x="20" y="35" width="680" height="385" as="geometry"/></mxCell><mxCell id="l2-lambda-38" value="&lt;b&gt;fp-sync&lt;/b&gt; (SQL client – poller)&lt;br&gt;container: ODBC Driver 18 + krb5&lt;br&gt;reserved concurrency = 1&lt;br&gt;kinit → read-only SELECTs  ②–⑩" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="l2-grp-37"><mxGeometry x="105" y="45" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-lambda-39" value="&lt;b&gt;fp-fetch&lt;/b&gt; (attachments + hand-off)&lt;br&gt;SMB 445 read (if enabled)&lt;br&gt;SQS trigger, max concurrency 2&lt;br&gt;⑪–⑭" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="l2-grp-37"><mxGeometry x="105" y="195" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-box-40" value="&lt;b&gt;sg-fp-client&lt;/b&gt; (both Lambdas)&lt;br&gt;egress TCP 1433 → SQL listener / replicas&lt;br&gt;egress TCP+UDP 88 → DCs&lt;br&gt;egress TCP 445 → file server (opt.)&lt;br&gt;egress TCP 443 → VPC-endpoint SG · no inbound" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l2-grp-37"><mxGeometry x="345" y="270" width="320" height="100" as="geometry"/></mxCell><mxCell id="l2-endpoints-41" value="&lt;b&gt;VPC endpoints&lt;/b&gt;&lt;br&gt;interface: secretsmanager, kms,&lt;br&gt;sqs, states, logs, monitoring,&lt;br&gt;sts, bedrock-agentcore&lt;br&gt;gateway: s3, dynamodb" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-36"><mxGeometry x="35" y="450" width="46" height="46" as="geometry"/></mxCell><mxCell id="l2-lambda-42" value="&lt;b&gt;Gateway tool Lambdas&lt;/b&gt;&lt;br&gt;get_ticket · get_attachment_text&lt;br&gt;query_cases (read-only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-36"><mxGeometry x="285" y="450" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-aurora-43" value="&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;br&gt;cases · extraction ·&lt;br&gt;audit (existing)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-36"><mxGeometry x="520" y="450" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-txt-44" value="&lt;b&gt;rtb-private-prd&lt;/b&gt;: FootPrints SQL / DC / file-server CIDRs [Validate] → TGW attachment · VPC CIDR → local · &lt;b&gt;no 0.0.0.0/0&lt;/b&gt;. VPC DNS (.2) → Resolver rule for boeing.com. CIDRs must not overlap." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#425466;spacing=2;" vertex="1" parent="l2-grp-35"><mxGeometry x="20" y="665" width="270" height="140" as="geometry"/></mxCell><mxCell id="l2-eventbridge-45" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;rate(5 minutes) → fp-sync (async)&lt;br&gt;retry 0, max event age 60 s  ①" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="60" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-secrets_manager-46" value="&lt;b&gt;Secrets Manager&lt;/b&gt;  fp/svc-fp-ro-prd&lt;br&gt;{realm, username, password}, CMK&lt;br&gt;rotation: AD-team process  ③" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="160" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-dynamodb-47" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;fp_checkpoint: rowversion watermark + lease  ② ⑩&lt;br&gt;fp_ledger: mrID#rowversion → status  ⑨ ⑬" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="260" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-sqs-48" value="&lt;b&gt;SQS fp-ticket-queue + DLQ&lt;/b&gt;&lt;br&gt;one message per changed ticket&lt;br&gt;maxReceiveCount 5 → DLQ  ⑨ ⑪" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="360" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-s3-49" value="&lt;b&gt;S3 fp-raw-prd&lt;/b&gt; (versioned, SSE-KMS)&lt;br&gt;tickets/144/{mrID}/{rowversion}/ticket.json,&lt;br&gt;descriptions, history, attachments/, manifest  ⑨ ⑫" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="460" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-guardduty-50" value="&lt;b&gt;GuardDuty Malware&lt;br&gt;Protection for S3&lt;/b&gt;&lt;br&gt;tags scan result  ⑮" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;" vertex="1" parent="l2-grp-34"><mxGeometry x="1255" y="460" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-key_management_service-51" value="&lt;b&gt;KMS customer-managed keys&lt;/b&gt;&lt;br&gt;secret · S3 · SQS · DynamoDB · ITAR key" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="560" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-step_functions-52" value="&lt;b&gt;Step Functions&lt;/b&gt; case-workflow&lt;br&gt;(Standard) name = fp144-mrID-rowversion&lt;br&gt;Retry / Catch  ⑭–⑰" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="660" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-lambda-53" value="&lt;b&gt;preprocess Lambda&lt;/b&gt;&lt;br&gt;attachment text, PII mask,&lt;br&gt;Guardrails  ⑮" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="l2-grp-34"><mxGeometry x="820" y="780" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-grp-54" value="Amazon Bedrock AgentCore — Runtime in VPC mode, private endpoints; agents read tickets only through Gateway tools" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#EFFAF8;strokeColor=#01A88D;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#00756A;" vertex="1" parent="l2-grp-34"><mxGeometry x="20" y="890" width="1335" height="200" as="geometry"/></mxCell><mxCell id="l2-bedrock_agentcore-55" value="&lt;b&gt;Classification agent&lt;/b&gt;&lt;br&gt;payment-related? ITAR?&lt;br&gt;confidence  ⑯" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="l2-grp-54"><mxGeometry x="85" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-bedrock_agentcore-56" value="&lt;b&gt;Extraction agent&lt;/b&gt;&lt;br&gt;PO, invoice no., supplier,&lt;br&gt;transaction date, details  ⑰" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="l2-grp-54"><mxGeometry x="345" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-bedrock_agentcore-57" value="&lt;b&gt;Reporting agent&lt;/b&gt;&lt;br&gt;consolidated analysis&lt;br&gt;and insights  ⑱" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="l2-grp-54"><mxGeometry x="605" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-bedrock_agentcore-58" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;MCP tools → Lambda targets&lt;br&gt;(read-only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="l2-grp-54"><mxGeometry x="935" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-bedrock-59" value="&lt;b&gt;Bedrock models&lt;/b&gt;&lt;br&gt;+ Guardrails&lt;br&gt;(approved list only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="l2-grp-54"><mxGeometry x="1205" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-grp-60" value="Observability and audit" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FDF2F8;strokeColor=#E7157B;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#A3115B;" vertex="1" parent="l2-grp-34"><mxGeometry x="20" y="1130" width="640" height="250" as="geometry"/></mxCell><mxCell id="l2-cloudwatch_2-61" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;logs, metrics,&lt;br&gt;alarms" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="l2-grp-60"><mxGeometry x="35" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-xray-62" value="&lt;b&gt;X-Ray / ADOT&lt;/b&gt;&lt;br&gt;trace mrID →&lt;br&gt;caseId → agent" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="l2-grp-60"><mxGeometry x="185" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-cloudtrail-63" value="&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;Secrets / KMS /&lt;br&gt;S3 data events" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="l2-grp-60"><mxGeometry x="335" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="l2-alarm-64" value="&lt;b&gt;Alarms → on-call&lt;/b&gt;&lt;br&gt;(SNS / ITSM)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="l2-grp-60"><mxGeometry x="495" y="43" width="46" height="46" as="geometry"/></mxCell><mxCell id="l2-txt-65" value="Alarms: any Kerberos or SQL login failure (stop polling to avoid AD lockout) · no successful sync for 20 min · DLQ depth &amp;gt; 0 · schema drift on MASTER144 · query duration &amp;gt; SLA · failed workflow executions · secret read by any other principal." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#425466;spacing=2;" vertex="1" parent="l2-grp-60"><mxGeometry x="15" y="160" width="610" height="80" as="geometry"/></mxCell><mxCell id="l2-box-66" value="&lt;b&gt;Failure handling and reprocessing&lt;/b&gt;&lt;br&gt;• Kerberos error (bad password, clock skew, missing SPN) or SQL 18456 → alarm, stop, watermark unchanged&lt;br&gt;• timeout / deadlock victim (1205) / blocking → back off, end the run; watermark unchanged; next run re-reads the same window&lt;br&gt;• fetch error → SQS retry with backoff → DLQ after 5 → fix and redrive · attachment unreadable → ticket processed, flagged&lt;br&gt;• agent / workflow error → Step Functions Retry/Catch → FAILED_AGENT → manual queue; reprocess = new execution name" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="l2-grp-34"><mxGeometry x="675" y="1130" width="680" height="120" as="geometry"/></mxCell><mxCell id="l2-box-67" value="&lt;b&gt;ITAR segregation [Decision: export-control approval]&lt;/b&gt;&lt;br&gt;Ticket text and attachments are copied before classification, so the ingestion account must sit inside the approved ITAR boundary. After classification, ITAR cases move to s3://fp-itar-prd under a separate KMS key whose policy allows US-person roles only; they go only to approved models/tools or to human review." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="l2-grp-34"><mxGeometry x="675" y="1260" width="680" height="120" as="geometry"/></mxCell><mxCell id="l2-grp-68" value="Environment boundaries — one AWS account, one secret and one firewall rule set per environment; two read-only AD accounts (non-prod, prod) as provided (details on page 3)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1590" width="2765" height="330" as="geometry"/></mxCell><mxCell id="l2-box-69" value="&lt;b&gt;DEV account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-dev · firewall rule set src = VPC-dev&lt;br&gt;Data source: schema-identical SQL Server mirror in the Dev account (RDS for SQL Server or container), synthetic workspace-144 tickets · optional Kerberos smoke test against non-prod FootPrints&lt;br&gt;Secret: none for Boeing (SQL login on the mirror only) or a copy of svc-fp-ro-nonprod for the smoke test [Decision]&lt;br&gt;Own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes and alarms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="l2-grp-68"><mxGeometry x="20" y="40" width="890" height="130" as="geometry"/></mxCell><mxCell id="l2-box-70" value="&lt;b&gt;UAT account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-uat · firewall rule set src = VPC-uat&lt;br&gt;Data source: non-production FootPrints SQL Server [Validate: exists] · Kerberos with svc-fp-ro-nonprod [Confirmed account]&lt;br&gt;Secret: fp/svc-fp-ro-nonprod (own CMK) · data per approved non-prod refresh&lt;br&gt;Own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes and alarms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="l2-grp-68"><mxGeometry x="935" y="40" width="890" height="130" as="geometry"/></mxCell><mxCell id="l2-box-71" value="&lt;b&gt;PROD account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-prd · firewall rule set src = VPC-prd&lt;br&gt;Data source: production FootPrints DB, preferably its readable secondary or reporting replica · Kerberos with svc-fp-ro-prd [Confirmed account]&lt;br&gt;Secret: fp/svc-fp-ro-prd (own CMK) · shadow mode (no outbound actions) before go-live&lt;br&gt;Own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes and alarms" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="l2-grp-68"><mxGeometry x="1850" y="40" width="890" height="130" as="geometry"/></mxCell><mxCell id="l2-txt-72" value="Same container image and IaC promoted Dev → UAT → Prod; only environment configuration differs (SQL host/port, database name, realm, KDC list, secret ARN, schedule, CIDRs). Secrets are created empty by IaC and filled by Boeing identity administrators." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="l2-grp-68"><mxGeometry x="20" y="190" width="2720" height="40" as="geometry"/></mxCell><mxCell id="l2-txt-73" value="&lt;b&gt;Attachments&lt;/b&gt; are not in SQL Server: MASTER144.mrATTACHMENTS holds file names only. Reading the files needs a separate read-only path (SMB share on the FootPrints server, TCP 445, Kerberos) [Decision with FootPrints owner]; without it the agents work from ticket text only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="l2-grp-68"><mxGeometry x="20" y="240" width="2720" height="40" as="geometry"/></mxCell><mxCell id="l2-e-74" value="HTTPS (existing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="l2-users-3" target="l2-box-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;jumpStyle=arc;jumpSize=8;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-box-5" target="l2-box-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-76" value="stores files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-box-5" target="l2-documents-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F6FD1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="l2-box-8" target="l2-box-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F6FD1;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-box-9" target="l2-generic_database-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-79" value="read-only routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F6FD1;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-box-8" target="l2-box-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-e-80" value="Windows login" style