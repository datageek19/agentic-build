<mxfile host="app.diagrams.net" agent="generated" version="24.0.0"><diagram id="l1" name="1 - Level 1 overview"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1-txt-1" value="&lt;b&gt;BMC FootPrints (workspace 144) → AWS via read-only SQL (Kerberos) → AgentCore&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#1F2933;spacing=2;" vertex="1" parent="1"><mxGeometry x="10" y="6" width="1140" height="26" as="geometry"/></mxCell><mxCell id="l1-txt-2" value="Same layout in Dev, UAT and Prod: each has its own AWS account, read-only service account, secret and firewall rule set" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1140" height="20" as="geometry"/></mxCell><mxCell id="l1-grp-3" value="Boeing on-prem network" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="1130" height="200" as="geometry"/></mxCell><mxCell id="l1-box-4" value="&lt;b&gt;FootPrints SQL Server&lt;/b&gt;&lt;br&gt;FootPrints DB · workspace 144 tables&lt;br&gt;MASTER144 (+ _DESCRIPTIONS, _HISTORY, …)&lt;br&gt;TDS 1433 + TLS · Windows auth" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-3"><mxGeometry x="20" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="l1-box-5" value="&lt;b&gt;FootPrints app server&lt;/b&gt;&lt;br&gt;attachment files (not in SQL)&lt;br&gt;read-only SMB share, TCP 445&lt;br&gt;[Validate: path / access]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-3"><mxGeometry x="390" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="l1-box-6" value="&lt;b&gt;Active Directory (KDC) and DNS&lt;/b&gt;&lt;br&gt;svc-fp-ro-nonprod / svc-fp-ro-prd&lt;br&gt;Kerberos TCP/UDP 88&lt;br&gt;internal DNS and CA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-3"><mxGeometry x="760" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="l1-v-7" value="Direct Connect or Site-to-Site VPN + Transit Gateway  ·  firewall allows only 1433 (SQL), 88 (Kerberos), 445 (attachments, optional), 53 (DNS)" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#EEF1F4;strokeColor=#7D8998;fontSize=13;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="10" y="290" width="1130" height="44" as="geometry"/></mxCell><mxCell id="l1-grp-8" value="AWS account, one per environment (Dev / UAT / Prod) — AWS GovCloud (US-West)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="10" y="365" width="1130" height="670" as="geometry"/></mxCell><mxCell id="l1-box-9" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;EventBridge&lt;br&gt;every 5 min (tunable)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="20" y="60" width="190" height="130" as="geometry"/></mxCell><mxCell id="l1-box-10" value="&lt;b&gt;Ingestion Lambda (FootPrints client)&lt;/b&gt;&lt;br&gt;private subnets (VPC)&lt;br&gt;kinit (Kerberos) + ODBC Driver 18&lt;br&gt;Trusted_Connection, read-only SELECTs&lt;br&gt;rowversion watermark" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCEBFB;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;strokeWidth=2;" vertex="1" parent="l1-grp-8"><mxGeometry x="240" y="60" width="330" height="130" as="geometry"/></mxCell><mxCell id="l1-box-11" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;service-account password&lt;br&gt;KMS key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="600" y="60" width="240" height="130" as="geometry"/></mxCell><mxCell id="l1-box-12" value="&lt;b&gt;Route 53 Resolver&lt;/b&gt;&lt;br&gt;outbound endpoint&lt;br&gt;to on-prem DNS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="870" y="60" width="240" height="130" as="geometry"/></mxCell><mxCell id="l1-box-13" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;ticket JSON + attachments&lt;br&gt;KMS, one bucket per env" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="20" y="255" width="250" height="110" as="geometry"/></mxCell><mxCell id="l1-box-14" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br&gt;watermark (rowversion)&lt;br&gt;ledger per ticket version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="300" y="255" width="250" height="110" as="geometry"/></mxCell><mxCell id="l1-box-15" value="&lt;b&gt;Amazon SQS + DLQ&lt;/b&gt;&lt;br&gt;one message per&lt;br&gt;changed ticket" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="580" y="255" width="250" height="110" as="geometry"/></mxCell><mxCell id="l1-box-16" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;case workflow&lt;br&gt;PII mask, Guardrails" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-8"><mxGeometry x="860" y="255" width="250" height="110" as="geometry"/></mxCell><mxCell id="l1-grp-17" value="Amazon Bedrock AgentCore" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=none;strokeColor=#8C4FFF;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#5A30B5;" vertex="1" parent="l1-grp-8"><mxGeometry x="20" y="415" width="1090" height="230" as="geometry"/></mxCell><mxCell id="l1-box-18" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;Lambda tools:&lt;br&gt;get_ticket, get_attachment_text&lt;br&gt;query_cases (read-only)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-17"><mxGeometry x="20" y="50" width="330" height="150" as="geometry"/></mxCell><mxCell id="l1-box-19" value="&lt;b&gt;Classification agent&lt;/b&gt;&lt;br&gt;payment-related?&lt;br&gt;ITAR? with confidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EBFD;strokeColor=#8C4FFF;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-17"><mxGeometry x="380" y="50" width="210" height="120" as="geometry"/></mxCell><mxCell id="l1-box-20" value="&lt;b&gt;Extraction agent&lt;/b&gt;&lt;br&gt;PO, invoice no., supplier,&lt;br&gt;transaction date, details" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EBFD;strokeColor=#8C4FFF;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-17"><mxGeometry x="610" y="50" width="220" height="120" as="geometry"/></mxCell><mxCell id="l1-box-21" value="&lt;b&gt;Reporting agent&lt;/b&gt;&lt;br&gt;insight report&lt;br&gt;from Aurora" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EBFD;strokeColor=#8C4FFF;fontColor=#1F2933;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="l1-grp-17"><mxGeometry x="850" y="50" width="210" height="120" as="geometry"/></mxCell><mxCell id="l1-txt-22" value="Highlighted: the only component with a network route and a credential to FootPrints. Agents never query SQL Server; they read the stored copy through Gateway tools." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="10" y="1045" width="1140" height="40" as="geometry"/></mxCell><mxCell id="l1-e-23" value="TDS 1433 + TLS (Kerberos)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1