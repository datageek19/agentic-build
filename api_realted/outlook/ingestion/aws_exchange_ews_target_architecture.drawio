e=auto;html=1;strokeColor=#1F6FD1;strokeWidth=2.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="env-box-13" target="env-box-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="817"/><mxPoint x="30" y="240"/></Array></mxGeometry></mxCell><mxCell id="env-grp-50" value="Tooling / CI-CD account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1160" y="920" width="1220" height="300" as="geometry"/></mxCell><mxCell id="env-box-51" value="&lt;b&gt;Pipeline&lt;/b&gt;: build one container image + IaC (CDK or Terraform) → deploy DEV → automated tests → manual approval → UAT → integration + security tests → change approval → PROD (shadow mode) → go-live approval" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-50"><mxGeometry x="30" y="50" width="1160" height="70" as="geometry"/></mxCell><mxCell id="env-box-52" value="&lt;b&gt;Promotion gates&lt;/b&gt;: connectivity smoke test (DNS, TLS, auth, GetFolder) · idempotency re-run · DLQ/redrive drill · golden-set accuracy thresholds · pen-test / security review · export-control sign-off before any live mail in an account" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E3A008;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-50"><mxGeometry x="30" y="140" width="1160" height="70" as="geometry"/></mxCell><mxCell id="env-txt-53" value="Environment-specific values (EWS URL, mailbox SMTP, secret ARN, CIDRs, schedule) come from SSM Parameter Store per account; secret values are entered by the client's identity admins, never by the pipeline." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#425466;spacing=2;" vertex="1" parent="env-grp-50"><mxGeometry x="30" y="230" width="1160" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>