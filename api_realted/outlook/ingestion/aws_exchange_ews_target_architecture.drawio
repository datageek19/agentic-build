=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2300" height="30" as="geometry"/></mxCell><mxCell id="env-grp-3" value="Client on-premises (corp.example)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="700" height="1120" as="geometry"/></mxCell><mxCell id="env-grp-4" value="Production Exchange org [Confirmed] — hosts all three mailboxes unless a non-prod org exists" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="50" width="660" height="520" as="geometry"/></mxCell><mxCell id="env-box-5" value="&lt;b&gt;Exchange VIP&lt;/b&gt; mail.corp.example:443&lt;br&gt;/EWS/Exchange.asmx" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="60" width="250" height="60" as="geometry"/></mxCell><mxCell id="env-box-6" value="&lt;b&gt;Shared mailbox ap-payments-dev&lt;/b&gt; [to provision]&lt;br&gt;granted only to svc-apmail-dev&lt;br&gt;synthetic / replayed mail only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-7" value="&lt;b&gt;svc-apmail-dev&lt;/b&gt; [to provision]&lt;br&gt;AD service account, non-interactive&lt;br&gt;FullAccess or Reviewer on its own mailbox only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="340" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-8" value="&lt;b&gt;Shared mailbox ap-payments-uat&lt;/b&gt; [to provision]&lt;br&gt;granted only to svc-apmail-uat&lt;br&gt;synthetic / replayed mail only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="270" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-9" value="&lt;b&gt;svc-apmail-uat&lt;/b&gt; [to provision]&lt;br&gt;AD service account, non-interactive&lt;br&gt;FullAccess or Reviewer on its own mailbox only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="340" y="270" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-10" value="&lt;b&gt;Shared mailbox ap-payments-prd&lt;/b&gt; [Confirmed]&lt;br&gt;granted only to svc-apmail-prd&lt;br&gt;live supplier mail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="20" y="390" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-11" value="&lt;b&gt;svc-apmail-prd&lt;/b&gt; [Confirmed]&lt;br&gt;AD service account, non-interactive&lt;br&gt;FullAccess or Reviewer on its own mailbox only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-4"><mxGeometry x="340" y="390" width="300" height="90" as="geometry"/></mxCell><mxCell id="env-box-12" value="&lt;b&gt;Optional non-prod Exchange org&lt;/b&gt; [Validate: exists?]&lt;br&gt;If available, point Dev/UAT here instead; the design does not depend on it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="590" width="660" height="70" as="geometry"/></mxCell><mxCell id="env-box-13" value="&lt;b&gt;Enterprise firewall&lt;/b&gt; — three rule sets [to provision]&lt;br&gt;VPC-dev CIDR → VIP:443 · VPC-uat CIDR → VIP:443 · VPC-prd CIDR → VIP:443&lt;br&gt;Resolver ENIs → DNS:53 · deny all else" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="690" width="660" height="90" as="geometry"/></mxCell><mxCell id="env-box-14" value="&lt;b&gt;Test-data harness&lt;/b&gt; [Recommended]&lt;br&gt;Sends a labelled synthetic golden set to the dev/uat mailboxes over SMTP from test senders, or imports approved, sanitized .eml files with EWS CreateItem (MimeContent, SaveOnly) into the test mailbox. Never replays ITAR or unapproved production mail into Dev/UAT." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="env-grp-3"><mxGeometry x="20" y="810" width="660" height="120" as="geometry"/></mxCell><mxCell id="env-grp-15" value="Network hub account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="360" height="1120" as="geometry"/></mxCell><mxCell id="env-direct_connect-16" value="&lt;b&gt;Direct Connect / S2S VPN&lt;/b&gt;&lt;br&gt;[Validate: existing]" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="env-grp-15"><mxGeometry x="151" y="70" width="52" height="52" as="geometry"/></mxCell><mxCell id="env-transit_gateway-17" value="&lt;b&gt;Transit Gateway&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="env-grp-15"><mxGeometry x="151" y="300" width="52" height="52" as="geometry"/></mxCell><mxCell id="env-box-18" value="&lt;b&gt;TGW route tables&lt;/b&gt;&lt;br&gt;rt-dev: VPC-dev ↔ on-prem only&lt;br&gt;rt-uat: VPC-uat ↔ on-prem only&lt;br&gt;rt-prd: VPC-prd ↔ on-prem only&lt;br&gt;no routes between environments" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F4FF;strokeColor=#8C4FFF;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="env-grp-15"><mxGeometry x="20" y="420" width="320" height="120" as="geometry"/></mxCell><mxCell id="env-route_53-19" value="&lt;b&gt;Resolver outbound endpoint&lt;/b&gt;&lt;br&gt;rule corp.example shared via RAM&lt;br&gt;to all three VPCs" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="env-grp-15"><mxGeometry x="151" y="620" width="52" height="52" as="geometry"/></mxCell><mxCell id="env-grp-20" value="Workload account — DEV" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="1220" height="240" as="geometry"/></mxCell><mxCell id="env-grp-21" value="VPC-dev (private only, CIDR non-overlapping – example 10.20.0.0/22)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResi