tlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="arch-grp-56"><mxGeometry x="605" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-bedrock_agentcore-60" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;MCP tools → Lambda targets&lt;br&gt;(read-only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="arch-grp-56"><mxGeometry x="935" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-bedrock-61" value="&lt;b&gt;Bedrock models&lt;/b&gt;&lt;br&gt;+ Guardrails&lt;br&gt;(approved list only)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="arch-grp-56"><mxGeometry x="1205" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-grp-62" value="Observability and audit" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FDF2F8;strokeColor=#E7157B;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#A3115B;" vertex="1" parent="arch-grp-36"><mxGeometry x="20" y="1130" width="640" height="250" as="geometry"/></mxCell><mxCell id="arch-cloudwatch_2-63" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;logs, metrics,&lt;br&gt;alarms" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="arch-grp-62"><mxGeometry x="35" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-xray-64" value="&lt;b&gt;X-Ray / ADOT&lt;/b&gt;&lt;br&gt;trace ledgerId →&lt;br&gt;caseId → agent" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="arch-grp-62"><mxGeometry x="185" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-cloudtrail-65" value="&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;Secrets / KMS /&lt;br&gt;S3 data events" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="arch-grp-62"><mxGeometry x="335" y="40" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-alarm-66" value="&lt;b&gt;Alarms → on-call&lt;/b&gt;&lt;br&gt;(SNS / ITSM)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="arch-grp-62"><mxGeometry x="495" y="43" width="46" height="46" as="geometry"/></mxCell><mxCell id="arch-txt-67" value="Alarms: any EWS 401 (stop polling to avoid AD lockout) · no successful sync for 15 min · DLQ depth &amp;gt; 0 · ledger items DISCOVERED &amp;gt; 30 min · failed workflow executions · agent error rate · secret read by any other principal." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#425466;spacing=2;" vertex="1" parent="arch-grp-62"><mxGeometry x="15" y="160" width="610" height="80" as="geometry"/></mxCell><mxCell id="arch-box-68" value="&lt;b&gt;Failure handling and reprocessing&lt;/b&gt;&lt;br&gt;• EWS 503 / ErrorServerBusy → honour BackOffMilliseconds, end the run; checkpoint stays at the last committed SyncState&lt;br&gt;• ErrorInvalidSyncState → full resync from a received-date floor; the ledger drops duplicates by InternetMessageId&lt;br&gt;• fetch error → SQS retry with backoff → DLQ after 5 → fix and redrive&lt;br&gt;• agent / workflow error → Step Functions Retry/Catch → FAILED_AGENT → manual queue; reprocess = new execution ledgerId#r2" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="arch-grp-36"><mxGeometry x="675" y="1130" width="680" height="120" as="geometry"/></mxCell><mxCell id="arch-box-69" value="&lt;b&gt;ITAR segregation [Decision: export-control approval]&lt;/b&gt;&lt;br&gt;Ingestion stores every email before it is classified, so the whole ingestion account must sit inside the approved ITAR boundary. After classification, ITAR cases move to s3://email-itar-prd under a separate KMS key whose policy allows US-person roles only; they go only to approved models/tools or to human review." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="arch-grp-36"><mxGeometry x="675" y="1260" width="680" height="120" as="geometry"/></mxCell><mxCell id="arch-grp-70" value="Environment boundaries — one AWS account, one mailbox, one AD service account, one secret and one firewall rule set per environment (details on page 2)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1590" width="2765" height="320" as="geometry"/></mxCell><mxCell id="arch-box-71" value="&lt;b&gt;DEV account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-dev · firewall rule src = VPC-dev → Exchange VIP:443&lt;br&gt;Mailbox: ap-payments-dev@ [to provision] · AD account: svc-apmail-dev [to provision]&lt;br&gt;Secret: ews/svc-apmail-dev (own CMK) · own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes, alarms&lt;br&gt;Data: synthetic emails only (no ITAR, no PII); schedule rate(5 min) or on demand" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="arch-grp-70"><mxGeometry x="20" y="40" width="890" height="120" as="geometry"/></mxCell><mxCell id="arch-box-72" value="&lt;b&gt;UAT account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-uat · firewall rule src = VPC-uat → Exchange VIP:443&lt;br&gt;Mailbox: ap-payments-uat@ [to provision] · AD account: svc-apmail-uat [to provision]&lt;br&gt;Secret: ews/svc-apmail-uat (own CMK) · own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes, alarms&lt;br&gt;Data: synthetic set + approved sanitized replay; production-like volume test" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="arch-grp-70"><mxGeometry x="935" y="40" width="890" height="120" as="geometry"/></mxCell><mxCell id="arch-box-73" value="&lt;b&gt;PROD account&lt;/b&gt; — own VPC (non-overlapping CIDR) · TGW route table rt-prd · firewall rule src = VPC-prd → Exchange VIP:443&lt;br&gt;Mailbox: production shared mailbox [Confirmed] · AD account: svc-apmail-prd [Confirmed]&lt;br&gt;Secret: ews/svc-apmail-prd (own CMK) · own DynamoDB, SQS, S3, Step Functions, AgentCore runtimes, alarms&lt;br&gt;Data: live mail; start in shadow mode (no outbound actions) before go-live" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;align=left;" vertex="1" parent="arch-grp-70"><mxGeometry x="1850" y="40" width="890" height="120" as="geometry"/></mxCell><mxCell id="arch-txt-74" value="Same container image and IaC promoted Dev → UAT → Prod; only environment configuration differs (EWS URL, mailbox SMTP address, secret ARN, schedule, CIDRs). Secrets are created empty by IaC and filled by the client's identity administrators." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="arch-grp-70"><mxGeometry x="20" y="180" width="2720" height="40" as="geometry"/></mxCell><mxCell id="arch-txt-75" value="&lt;b&gt;If only a production Exchange org exists&lt;/b&gt; [Assumption to validate]: Dev and UAT mailboxes and accounts live on the production Exchange org; isolation comes from separate mailboxes, accounts, firewall rules and AWS accounts, not separate servers." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="arch-grp-70"><mxGeometry x="20" y="230" width="2720" height="40" as="geometry"/></mxCell><mxCell id="arch-e-76" value="SMTP 25 (existing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="arch-users-5" target="arch-box-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-e-77" value="transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#7D8998;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-box-7" target="arch-email-13"><mxGeometry x="-0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="278"/><mxPoint x="310" y="540"/><mxPoint x="444" y="540"/></Array></mxGeometry></mxCell><mxCell id="arch-e-78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F6FD1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=10;fontColor=#1F6FD1;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" edge="1" parent="1" source="arch-box-10" target="arch-box-11"><mxGeometry relative="1