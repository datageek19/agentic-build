<mxfile host="app.diagrams.net" agent="generated" version="24.0.0"><diagram id="arch" name="1 - Target architecture (per environment)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-txt-1" value="&lt;b&gt;Exchange (on-premises) → AWS email ingestion via EWS → Bedrock AgentCore workflow — detailed target architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontColor=#1F2933;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2200" height="34" as="geometry"/></mxCell><mxCell id="arch-txt-2" value="One environment shown (PROD). Dev and UAT are identical stacks in their own accounts (page 2). Tags: &lt;b&gt;[Confirmed]&lt;/b&gt; stated requirement · &lt;b&gt;[Recommended]&lt;/b&gt; design choice · &lt;b&gt;[Validate]&lt;/b&gt; must be confirmed with Exchange / AD / network / security owners · &lt;b&gt;[Decision]&lt;/b&gt; needs an owner's approval. Circled numbers ①–⑱ match the sequence diagram and the implementation guide." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#425466;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="2200" height="40" as="geometry"/></mxCell><mxCell id="arch-grp-3" value="Legend" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FFFFFF;strokeColor=#AAB7B8;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1340" width="1015" height="112" as="geometry"/></mxCell><mxCell id="arch-txt-4" value="&lt;font color='#1F6FD1'&gt;&lt;b&gt;━━ blue&lt;/b&gt;&lt;/font&gt;: EWS SOAP over HTTPS 443 (AWS → on-prem)&lt;br&gt;&lt;font color='#D86613'&gt;&lt;b&gt;┅┅ orange&lt;/b&gt;&lt;/font&gt;: DNS (UDP/TCP 53) hybrid resolution &amp;nbsp; | &amp;nbsp; &lt;font color='#232F3E'&gt;&lt;b&gt;━━ dark&lt;/b&gt;&lt;/font&gt;: AWS API calls inside the account (IAM-signed, via VPC endpoints)&lt;br&gt;&lt;font color='#01A88D'&gt;&lt;b&gt;━━ teal&lt;/b&gt;&lt;/font&gt;: agentic workflow / AgentCore invocations &amp;nbsp; | &amp;nbsp; &lt;font color='#D13212'&gt;&lt;b&gt;┅┅ red&lt;/b&gt;&lt;/font&gt;: failure, retry, alarm paths&lt;br&gt;&lt;font color='#7D8998'&gt;&lt;b&gt;┅┅ grey&lt;/b&gt;&lt;/font&gt;: existing on-prem flows / permissions" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1F2933;spacing=2;" vertex="1" parent="arch-grp-3"><mxGeometry x="10" y="22" width="990" height="88" as="geometry"/></mxCell><mxCell id="arch-users-5" value="&lt;b&gt;External suppliers / vendors&lt;/b&gt;&lt;br&gt;payment &amp;amp; procurement emails" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="44" height="44" as="geometry"/></mxCell><mxCell id="arch-grp-6" value="Client on-premises network (corp.example) — enterprise trust zone  [Confirmed: shared mailbox is on-prem; Graph not available]" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="820" height="1110" as="geometry"/></mxCell><mxCell id="arch-box-7" value="&lt;b&gt;Inbound mail gateway / Edge (existing)&lt;/b&gt;&lt;br&gt;delivers to Exchange transport" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="50" width="260" height="56" as="geometry"/></mxCell><mxCell id="arch-grp-8" value="Microsoft Exchange Server — version / CU [Validate]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="130" width="530" height="490" as="geometry"/></mxCell><mxCell id="arch-txt-9" value="Expected 2019 CU14+ or Exchange SE; 2016/2019 left support on 14-Oct-2025" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6C86;spacing=2;" vertex="1" parent="arch-grp-8"><mxGeometry x="12" y="20" width="510" height="20" as="geometry"/></mxCell><mxCell id="arch-box-10" value="&lt;b&gt;Exchange namespace VIP&lt;/b&gt;&lt;br&gt;mail.corp.example : 443 (FQDN on cert SAN)&lt;br&gt;Load balancer: L4 pass-through or SSL bridging&lt;br&gt;&lt;i&gt;no SSL offload (breaks Extended Protection)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-8"><mxGeometry x="20" y="70" width="240" height="100" as="geometry"/></mxCell><mxCell id="arch-box-11" value="&lt;b&gt;Client Access (front end) – IIS&lt;/b&gt;&lt;br&gt;POST /EWS/Exchange.asmx&lt;br&gt;Auth: Negotiate (NTLMv2 / Kerberos)&lt;br&gt;Extended Protection: channel binding (CBT)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD1;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-8"><mxGeometry x="280" y="70" width="235" height="100" as="geometry"/></mxCell><mxCell id="arch-box-12" value="&lt;b&gt;Mailbox role – EWS back end&lt;/b&gt;&lt;br&gt;Throttling policy for svc-apmail-*&lt;br&gt;(EWSMaxConcurrency, budgets) [Validate]&lt;br&gt;EWS request limit 64 MB default" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6C86;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-8"><mxGeometry x="20" y="230" width="240" height="100" as="geometry"/></mxCell><mxCell id="arch-email-13" value="&lt;b&gt;Shared mailbox&lt;/b&gt;&lt;br&gt;ap-payments@corp.example [placeholder]&lt;br&gt;Inbox → optional 'AI-Processed' folder" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.email;" vertex="1" parent="arch-grp-8"><mxGeometry x="380" y="235" width="48" height="48" as="geometry"/></mxCell><mxCell id="arch-box-14" value="&lt;b&gt;Mailbox permission for the service account [Validate]&lt;/b&gt;&lt;br&gt;FullAccess, AutoMapping off (read + categorize/move)&lt;br&gt;&lt;i&gt;or&lt;/i&gt; Inbox 'Reviewer' (strict read-only)&lt;br&gt;No ApplicationImpersonation, no Send-As (phase 1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#E3A008;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-8"><mxGeometry x="20" y="375" width="495" height="90" as="geometry"/></mxCell><mxCell id="arch-grp-15" value="Active Directory / identity (corp.example)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#FAFBFC;strokeColor=#5A6C86;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="arch-grp-6"><mxGeometry x="575" y="130" width="230" height="490" as="geometry"/></mxCell><mxCell id="arch-traditional_server-16" value="&lt;b&gt;AD DS domain controllers&lt;/b&gt;&lt;br&gt;NTLM pass-through validation&lt;br&gt;KDC TCP/UDP 88 (Kerberos)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="arch-grp-15"><mxGeometry x="95" y="55" width="40" height="48" as="geometry"/></mxCell><mxCell id="arch-role-17" value="&lt;b&gt;Service account(s)&lt;/b&gt;&lt;br&gt;svc-apmail-prd [Confirmed]&lt;br&gt;svc-apmail-uat / -dev [to provision]&lt;br&gt;non-interactive" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="arch-grp-15"><mxGeometry x="93" y="185" width="44" height="44" as="geometry"/></mxCell><mxCell id="arch-box-18" value="&lt;b&gt;Enterprise PKI&lt;/b&gt;&lt;br&gt;issues Exchange TLS cert;&lt;br&gt;CA chain → Lambda trust store" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-15"><mxGeometry x="15" y="325" width="200" height="66" as="geometry"/></mxCell><mxCell id="arch-box-19" value="&lt;b&gt;Internal DNS&lt;/b&gt;&lt;br&gt;zone corp.example" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-15"><mxGeometry x="15" y="410" width="200" height="56" as="geometry"/></mxCell><mxCell id="arch-generic_firewall-20" value="&lt;b&gt;Enterprise firewall&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_firewall;" vertex="1" parent="arch-grp-6"><mxGeometry x="605" y="680" width="48" height="48" as="geometry"/></mxCell><mxCell id="arch-customer_gateway-21" value="&lt;b&gt;WAN edge / DX router&lt;/b&gt;&lt;br&gt;customer gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.customer_gateway;" vertex="1" parent="arch-grp-6"><mxGeometry x="725" y="680" width="48" height="48" as="geometry"/></mxCell><mxCell id="arch-box-22" value="&lt;b&gt;Firewall rules, one set per environment [Validate]&lt;/b&gt;&lt;br&gt;ALLOW env subnet CIDRs → Exchange VIP TCP 443&lt;br&gt;ALLOW Resolver outbound ENI IPs → DNS UDP/TCP 53&lt;br&gt;(only if Kerberos) ALLOW → DCs TCP/UDP 88&lt;br&gt;DENY everything else from AWS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#D13212;fontColor=#1F2933;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="arch-grp-6"><mxGeometry x="570" y="790" width="235" height="140" as="geometry"/></mxCell><mxCell id="arch-box-23" value="&lt;b&gt;Option B — fallback only&lt;/b&gt;: an on-prem relay (container/VM in the client network) runs the same EWS client and pushes .eml + metadata to S3/SQS over outbound HTTPS 443 (IAM Roles Anywhere). Use only if inbound AWS → Exchange 443 is refused." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="660" width="530" height="80" as="geometry"/></mxCell><mxCell id="arch-box-24" value="&lt;b&gt;Enterprise proxy option [Validate]&lt;/b&gt;: if policy forces AWS traffic through an internal reverse proxy / WAF, it must SSL-bridge with the &lt;i&gt;same&lt;/i&gt; certificate as Exchange and pass Negotiate/NTLM headers unchanged; SSL offload fails Extended Protection." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7D8998;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="755" width="530" height="80" as="geometry"/></mxCell><mxCell id="arch-box-25" value="&lt;b&gt;Trust boundary (on-prem ↔ AWS)&lt;/b&gt;&lt;br&gt;Only the two ews-* Lambdas open connections, outbound from AWS to the Exchange VIP on 443 (plus DNS from the Resolver endpoint). Nothing on-prem connects into AWS in Option A. The password leaves Secrets Manager only into Lambda memory; it is never logged, sent to agents, or stored on disk." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D13212;fontColor=#1F2933;fontSize=11;align=center;verticalAlign=middle;spacing=4;dashed=1;align=left;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="950" width="785" height="90" as="geometry"/></mxCell><mxCell id="arch-txt-26" value="&lt;b&gt;Existing mail path (unchanged):&lt;/b&gt; suppliers → SMTP → Exchange transport → shared mailbox." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;spacing=2;" vertex="1" parent="arch-grp-6"><mxGeometry x="20" y="1060" width="780" height="30" as="geometry"/></mxCell><mxCell id="arch-grp-27" value="Hybrid connectivity [Validate: existing circuits]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;fillColor=#F7F4FF;strokeColor=#8C4FFF;dashed=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="860" y="660" width="175" height="560" as="geometry"/></mxCell><mxCell id="arch-direct_connect-28" value="&lt;b&gt;AWS Direct Connect&lt;/b&gt;&lt;br&gt;private / transit VIF&lt;br&gt;→ Direct Connect gateway&lt;br&gt;[Recommended: primary]" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="arch-grp-27"><mxGeometry x="61" y="50" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-site_to_site_vpn-29" value="&lt;b&gt;Site-to-Site VPN&lt;/b&gt;&lt;br&gt;2 IPsec tunnels, BGP&lt;br&gt;[backup, or primary&lt;br&gt;if no Direct Connect]" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.site_to_site_vpn;" vertex="1" parent="arch-grp-27"><mxGeometry x="61" y="220" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-txt-30" value="TLS 1.2+ protects EWS end to end. Add MACsec or VPN-over-DX if policy requires layer-3 encryption on the circuit." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A30B5;spacing=2;" vertex="1" parent="arch-grp-27"><mxGeometry x="8" y="400" width="160" height="150" as="geometry"/></mxCell><mxCell id="arch-grp-31" value="AWS — partition / Region [Decision]: AWS GovCloud (US-West) if ITAR data is in scope (export-control approval), otherwise an approved commercial Region" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1055" y="90" width="1730" height="1470" as="geometry"/></mxCell><mxCell id="arch-grp-32" value="Network hub account (shared networking)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="arch-grp-31"><mxGeometry x="20" y="50" width="305" height="1000" as="geometry"/></mxCell><mxCell id="arch-transit_gateway-33" value="&lt;b&gt;AWS Transit Gateway&lt;/b&gt;&lt;br&gt;route tables rt-dev | rt-uat | rt-prd&lt;br&gt;(segmented: no dev↔prd)&lt;br&gt;on-prem CIDRs propagated from DX/VPN" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="arch-grp-32"><mxGeometry x="125" y="70" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-route_53-34" value="&lt;b&gt;Route 53 Resolver&lt;/b&gt;&lt;br&gt;outbound endpoint (2 AZs)&lt;br&gt;rule: corp.example → on-prem DNS&lt;br&gt;shared to workload accounts (RAM)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="arch-grp-32"><mxGeometry x="125" y="290" width="52" height="52" as="geometry"/></mxCell><mxCell id="arch-txt-35" value="TGW attachments: DX gateway, VPN, VPC-dev, VPC-uat, VPC-prd. Each workload VPC route table sends only on-prem CIDRs to the TGW. The ingestion path needs no internet egress." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#425466;spacing=2;" vertex="1" parent="arch-grp-32"><mxGeometry x="15" y="500" width="280" height="110" as="geometry"/></mxCell><mxCell id="arch-grp-36" value="Workload account — PROD   (Dev and UAT accounts are identical; see page 2)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.