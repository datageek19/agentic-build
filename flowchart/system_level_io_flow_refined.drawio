        <mxCell id="Cn6" value="Group Mailbox - Payment status Query" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="121" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn7" value="INPUT zone + P17 correlation" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="121" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn8" value="Thread, not message, is the unit of work. A reply appends to an open case instead of opening a new one." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="121" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn9" value="FR5 - correlate replies to the same conversation and case" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1350" y="121" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn10" value="Does it have PO ID / Invoice ID / Supplier Name" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="191" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn11" value="Band 1 identification rows + P1 / P2 / P3" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="191" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn12" value="Each decision now names the pull it triggers, its key and its returned fields." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="191" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn13" value="FR8, FR9, EE-01..12" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#f7f7f7;strokeColor=#b3b3b3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1350" y="191" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn14" value="Get SAP Invoice ID  (lane 1 entry)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#fff4f4;strokeColor=#d79b9b;fontSize=8;fontColor=#a03535;" vertex="1" parent="1"><mxGeometry x="30" y="261" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn15" value="P7, demoted to secondary" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#fff4f4;strokeColor=#d79b9b;fontSize=8;fontColor=#a03535;" vertex="1" parent="1"><mxGeometry x="430" y="261" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn16" value="REORDERED. The flow no longer enters through S/4. Ariba is queried first and S/4 corroborates." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#fff4f4;strokeColor=#d79b9b;fontSize=8;fontColor=#a03535;" vertex="1" parent="1"><mxGeometry x="830" y="261" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="Cn17" value="Stage 1 decision 2 - Ariba is system of record" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;rounded=0;fillColor=#fff4f4;strokeColor=#d79b9b;fontSize=8;fontColor=#a03535;" vertex="1" parent="1"><mxGeometry x="1350" y="261" width="600" height="70" as="geometry"/></mxCell>
